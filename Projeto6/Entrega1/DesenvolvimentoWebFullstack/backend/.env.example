# Connection string do Supabase: no painel do projeto, botao "Connect" no
# topo > "Session pooler" (funciona em qualquer rede). Troque [YOUR-PASSWORD]
# pela senha do banco que voce definiu ao criar o projeto (sem os colchetes;
# se a senha tiver @, # ou /, prefira trocar por uma so com letras e numeros).
DATABASE_URL=postgresql://postgres.SEU_PROJETO:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=troque-isso-por-uma-frase-longa-e-aleatoria

# Opcional. Fuso usado pelo banco e pelo Node (padrao: America/Sao_Paulo)
# DB_TIMEZONE=America/Sao_Paulo

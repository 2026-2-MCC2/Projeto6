# Nada aqui e obrigatorio para rodar no computador.
# Sem .env o backend usa um banco local embutido (pasta .banco-local),
# criado sozinho com as tabelas e o seed na primeira vez.

# Opcional: usar o banco compartilhado do Supabase em vez do local.
# No painel do projeto, botao "Connect" no topo > "Session pooler". Troque
# [YOUR-PASSWORD] pela senha do banco (sem os colchetes). A rede da
# faculdade bloqueia essa conexao; em casa funciona.
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Opcional: em desenvolvimento ja existe um valor padrao.
# Na Vercel e obrigatorio (Settings > Environment Variables).
# JWT_SECRET=troque-isso-por-uma-frase-longa-e-aleatoria

# PORT=3000

# So se o front ficar hospedado em outro dominio (normalmente nao precisa).
# CORS_ORIGIN=https://exemplo.com

# Fuso usado pelo banco e pelo Node (padrao: America/Sao_Paulo)
# DB_TIMEZONE=America/Sao_Paulo
